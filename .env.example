# Names only. Real values go in .env, which is git-ignored. Never paste values into chat.

# Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Secret that protects the embed function (make up a long random string)
ADMIN_KEY=

# Claude
